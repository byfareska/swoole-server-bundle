{
    "name": "byfareska/swoole-server-bundle",
    "description": "Long-running Swoole HTTP server for Symfony applications (PHP-FPM-like worker model, no coroutines)",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": [
        "swoole",
        "symfony",
        "bundle",
        "http-server",
        "long-running",
        "worker",
        "performance"
    ],
    "authors": [
        {
            "name": "Karol Szarafinowski",
            "email": "karol@szarafinowski.pl"
        }
    ],
    "homepage": "https://github.com/byfareska/swoole-server-bundle",
    "support": {
        "issues": "https://github.com/byfareska/swoole-server-bundle/issues",
        "source": "https://github.com/byfareska/swoole-server-bundle"
    },
    "require": {
        "php": ">=8.5",
        "ext-swoole": "*",
        "psr/log": "^3.0",
        "symfony/config": "^8.0",
        "symfony/console": "^8.0",
        "symfony/dependency-injection": "^8.0",
        "symfony/error-handler": "^8.0",
        "symfony/http-foundation": "^8.0",
        "symfony/http-kernel": "^8.0",
        "symfony/service-contracts": "^3.6"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^12.0",
        "swoole/ide-helper": "^6.2",
        "symfony/framework-bundle": "^8.0",
        "symfony/mime": "^8.1"
    },
    "suggest": {
        "symfony/monolog-bundle": "Routes the bundle's logs through the dedicated \"swoole_server\" monolog channel",
        "symfony/mime": "Content-Type guessing for files served via BinaryFileResponse",
        "symfony/flex": "Automatic bundle registration and configuration via the shipped recipe"
    },
    "autoload": {
        "psr-4": {
            "Byfareska\\SwooleServer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Byfareska\\SwooleServer\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "cs-check": [
            "@putenv PHP_CS_FIXER_IGNORE_ENV=1",
            "php-cs-fixer check --diff"
        ],
        "cs-fix": [
            "@putenv PHP_CS_FIXER_IGNORE_ENV=1",
            "php-cs-fixer fix"
        ]
    }
}
